datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  avatar        String?
  bio           String?
  isPublic      Boolean  @default(false)
  role          String   @default("user")
  bannedUntil   DateTime?
  banReason     String?
  createdAt     DateTime @default(now())

  habits             Habit[]
  logs               HabitLog[]
  wagersAsUser       Wager[]        @relation("WagerUser")
  wagersAsPeer       Wager[]        @relation("WagerPeer")
  presets            Preset[]
  presetUsages       PresetUsage[]
  sentRequests       FriendRequest[] @relation("Requester")
  receivedRequests   FriendRequest[] @relation("Receiver")
  friendships1       Friendship[]    @relation("User1")
  friendships2       Friendship[]    @relation("User2")
  challengesAsCreator  Challenge[] @relation("ChallengeCreator")
  challengesAsOpponent Challenge[] @relation("ChallengeOpponent")
  activities         Activity[]
  breaks             HabitBreak[]
  vacations          Vacation[]
  tasks              Task[]
  taskLogs           TaskLog[]
  reports            Report[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  notificationPrefs  NotificationPreference?
  friendLinksSent    FriendLink[] @relation("FriendLinkSender")
  passwordResets     PasswordReset[]
}

model Habit {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  emoji            String      @default("🎯")
  frequencyType    String      @default("daily")
  daysPerWeek      Json        @default("[1,2,3,4,5,6,7]")
  config           Json?
  verificationType String      @default("honor")
  active           Boolean     @default(true)
  bestStreak       Int         @default(0)
  isPublic         Boolean     @default(false)
  wagerDays        Int         @default(0)
  wagerAmount      Float       @default(0)
  finishedAt       DateTime?
  finishedNote     String?
  createdAt        DateTime    @default(now())

  presetId         String?
  wagers           Wager[]
  logs             HabitLog[]
  challenges       Challenge[]
  breaks           HabitBreak[]
  tags             HabitTag[]
}

model HabitTag {
  id       String @id @default(uuid())
  habitId  String
  habit    Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  name     String
  color    String?
}

model Wager {
  id             String    @id @default(uuid())
  habitId        String
  habit          Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation("WagerUser", fields: [userId], references: [id])
  counterpartyId String?
  counterparty   User?     @relation("WagerPeer", fields: [counterpartyId], references: [id])
  condition      String
  penaltyText    String    @default("")
  status         String    @default("active")
  createdAt      DateTime  @default(now())
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  completedAt DateTime @default(now())
  status      String   @default("completed")
  proofUrl    String?
  verifiedBy  String?
}

model HabitBreak {
  id        String    @id @default(uuid())
  habitId   String
  habit     Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  startDate DateTime  @default(now())
  endDate   DateTime?
  reason    String?
}

model Vacation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  startDate DateTime
  endDate   DateTime?
  reason    String?
  createdAt DateTime  @default(now())
}

model Preset {
  id               String   @id @default(uuid())
  authorId         String
  author           User     @relation(fields: [authorId], references: [id])
  authorName       String?
  title            String
  description      String?
  emoji            String?
  category         String   @default("general")
  frequencyType    String   @default("daily")
  daysPerWeek      Json?
  verificationType String   @default("honor")
  config           Json?
  isPublished      Boolean  @default(false)
  likesCount       Int      @default(0)
  forksCount       Int      @default(0)
  usagesCount      Int      @default(0)
  createdAt        DateTime @default(now())

  habitId          String?
  likes            PresetLike[]
  usages           PresetUsage[]
}

model PresetLike {
  id        String   @id @default(uuid())
  userId    String
  presetId  String
  preset    Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, presetId])
}

model PresetUsage {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  presetId       String
  preset         Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
  isOriginal     Boolean  @default(false)
  completions    Int      @default(0)
  currentStreak  Int      @default(0)
  bestStreak     Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([userId, presetId])
}

model Challenge {
  id         String    @id @default(uuid())
  creatorId  String
  creator    User      @relation("ChallengeCreator", fields: [creatorId], references: [id])
  opponentId String
  opponent   User      @relation("ChallengeOpponent", fields: [opponentId], references: [id])
  habitId    String
  habit      Habit     @relation(fields: [habitId], references: [id])
  title      String    @default("")
  description String?
  startDate  DateTime  @default(now())
  endDate    DateTime  @default(now())
  stake      String?
  status     String    @default("active")
  winnerId   String?
  createdAt  DateTime  @default(now())
}

model FriendRequest {
  id          String   @id @default(uuid())
  requesterId String
  requester   User     @relation("Requester", fields: [requesterId], references: [id])
  receiverId  String
  receiver    User     @relation("Receiver", fields: [receiverId], references: [id])
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Friendship {
  id       String @id @default(uuid())
  user1Id  String
  user1    User   @relation("User1", fields: [user1Id], references: [id])
  user2Id  String
  user2    User   @relation("User2", fields: [user2Id], references: [id])
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
}

model Activity {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String
  payload    Json?
  visibility String   @default("friends")
  createdAt  DateTime @default(now())
}

model Report {
  id           String   @id @default(uuid())
  reporterId   String
  reporter     User     @relation(fields: [reporterId], references: [id])
  targetType   String
  targetId     String
  reason       String
  description  String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  description String?
  emoji       String    @default("📝")
  dueDate     DateTime?
  isScheduled Boolean   @default(true)
  isEveryday  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  logs        TaskLog[]
}

model TaskLog {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  completedAt DateTime @default(now())
  note        String?
  proofUrl    String?
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FriendLink {
  id        String    @id @default(uuid())
  senderId  String
  sender    User      @relation("FriendLinkSender", fields: [senderId], references: [id], onDelete: Cascade)
  token     String    @unique
  used      Boolean   @default(false)
  usedById  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
}

model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  morningEnabled        Boolean  @default(true)
  morningTime           String   @default("08:00")
  habitRemindersEnabled Boolean  @default(true)
  eveningEnabled        Boolean  @default(true)
  eveningTime           String   @default("21:00")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
