datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  name          String
  avatar        String?
  bio           String?
  isPublic      Boolean  @default(false)
  referralCode  String   @unique @default(uuid())
  role          String   @default("user")
  bannedUntil   DateTime?
  createdAt     DateTime @default(now())

  habits        Habit[]
  logs          HabitLog[]
  wagersAsUser  Wager[]        @relation("WagerUser")
  wagersAsPeer  Wager[]        @relation("WagerPeer")
  presets       Preset[]
  presetUsages  PresetUsage[]

  sentRequests     FriendRequest[] @relation("Requester")
  receivedRequests FriendRequest[] @relation("Receiver")
  friendships1     Friendship[]    @relation("User1")
  friendships2     Friendship[]    @relation("User2")

  challengesAsCreator  Challenge[] @relation("ChallengeCreator")
  challengesAsOpponent Challenge[] @relation("ChallengeOpponent")

  activities     Activity[]
  breaks          HabitBreak[]
  vacations       Vacation[]
  tasks           Task[]
  taskLogs        TaskLog[]
}

model Habit {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  recurrence       Json
  verificationType String      @default("honor")
  active           Boolean     @default(true)
  endDate          DateTime?
  finishedAt       DateTime?
  finishNote       String?
  createdAt        DateTime    @default(now())

  presetId         String?
  preset           Preset?     @relation(fields: [presetId], references: [id])
  wagers           Wager[]
  logs             HabitLog[]
  challenges       Challenge[]
  breaks           HabitBreak[]
}

model Wager {
  id             String   @id @default(uuid())
  habitId        String
  habit          Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation("WagerUser", fields: [userId], references: [id])
  counterpartyId String?
  counterparty   User?    @relation("WagerPeer", fields: [counterpartyId], references: [id])
  condition      String
  penaltyText    String
  status         String   @default("active")
  createdAt      DateTime @default(now())
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  completedAt DateTime @default(now())
  status      String   @default("completed")
  proofUrl    String?
  verifiedBy  String?
}

model Preset {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  title       String
  description String
  config      Json
  category    String   @default("general")
  likesCount  Int      @default(0)
  forksCount  Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  habits      Habit[]
  likes       PresetLike[]
  usages      PresetUsage[]
}

model PresetLike {
  id        String   @id @default(uuid())
  userId    String
  presetId  String
  preset    Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, presetId])
}

model PresetUsage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  presetId  String
  preset    Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
  isOriginal Boolean @default(true)
  completions Int    @default(0)
  currentStreak Int  @default(0)
  bestStreak   Int   @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, presetId])
}

model FriendRequest {
  id         String   @id @default(uuid())
  requesterId String
  requester  User     @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@unique([requesterId, receiverId])
}

model Friendship {
  id        String   @id @default(uuid())
  user1Id   String
  user1     User     @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String
  user2     User     @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
}

model Challenge {
  id          String   @id @default(uuid())
  creatorId   String
  creator     User     @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  opponentId  String
  opponent    User     @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  stake       String?
  status      String   @default("active")
  winnerId    String?
  createdAt   DateTime @default(now())
}

model Activity {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  payload    Json
  visibility String   @default("friends")
  createdAt  DateTime @default(now())
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  description String?
  status      String   @default("pending")
  adminNote   String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model HabitBreak {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime @default(now())
  endDate   DateTime?
  reason    String?
  createdAt DateTime @default(now())

  @@unique([habitId, userId])
}

model Vacation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime @default(now())
  endDate   DateTime?
  reason    String?
  createdAt DateTime @default(now())
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  isScheduled Boolean   @default(false)
  completed   Boolean   @default(false)
  completedAt DateTime?
  finishNote  String?
  createdAt   DateTime  @default(now())

  logs        TaskLog[]
}

model TaskLog {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  completedAt DateTime @default(now())
  note        String?
  proofUrl    String?
}
