# BeBetter - Single source of truth for all configuration.
# Copy to `.env` and adjust before deploying: cp .env.example .env

# Domain (used by Traefik routing)
DOMAIN=bebetter.websters.at

# Database
POSTGRES_USER=bebetter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bebetter_db

# Auth
JWT_SECRET=change-me-long-random-string
ADMIN_PASSWORD=change-me

# SMTP (used for transactional mail if enabled)
SMTP_PASSWORD=

# App
TZ=Europe/Vienna

# Push notifications (WebPush VAPID)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=