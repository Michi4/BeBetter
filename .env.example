# BeBetter - Single source of truth for all configuration.
# Copy to `.env` and adjust before deploying: cp .env.example .env
# NEVER commit `.env` (gitignored) — it holds real secrets.

# Domain (used by Traefik routing)
DOMAIN=bebetter.websters.at

# Frontend origin used in emailed links (e.g. password reset)
FRONTEND_URL=https://bebetter.websters.at

# Database
POSTGRES_USER=bebetter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bebetter_db

# Auth — REQUIRED in production. The app refuses to boot without it.
# Generate: openssl rand -hex 48
JWT_SECRET=change-me-long-random-string
# Required only when running `npm run db:seed` (never in prod runtime)
ADMIN_PASSWORD=change-me

# Demo account (defaults to username `demo`)
DEMO_USERNAME=demo
DEMO_PASSWORD=change-me

# LLM assistant (b.ai-compatible API)
B_AI_API_KEY=
B_AI_BASE_URL=https://api.b.ai/v1
AI_MODELS=

# SMTP (transactional mail: password resets). Code reads SMTP_HOST/PORT/USER/PASS/FROM.
# Example (purelymail): HOST=smtp.purelymail.com PORT=587 USER=you@domain.at
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BeBetter <you@domain.at>"

# App
TZ=Europe/Vienna
NODE_ENV=production

# Push notifications (WebPush VAPID) — file vapid-keys.json is used when unset
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
